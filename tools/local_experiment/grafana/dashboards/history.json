    {
      "id": 5,
      "type": "table",
      "title": "Query Doctor · SELECT と EXPLAIN",
      "description": "診断実行順に最大512件。最新の保存履歴を表示します。作成→終了と開始→終了は待ち時間の含み方が異なり、合計しません。NULLは未観測です。",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "shirokuma-agenthouse-readonly"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "shirokuma-agenthouse-readonly"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT case_id, kind, response_state, history_status,\ncreated_to_end_ms, started_to_end_ms, query_id\nFROM agenthouse.query_history_queries FINAL\nWHERE kind IN ('select', 'explain')\nORDER BY query_run_token, request_index LIMIT 512",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "未観測",
          "decimals": 0,
          "custom": {
            "filterable": true,
            "minWidth": 80,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "case_id"
            },
            "properties": [

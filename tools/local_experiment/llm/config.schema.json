{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shirokuma local LLM provider configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "active_provider",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "active_provider": {
      "enum": [
        "mock",
        "local"
      ]
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mock",
        "local",
        "cloud"
      ],
      "properties": {
        "mock": {
          "allOf": [
            {
              "$ref": "#/$defs/profile"
            },
            {
              "properties": {
                "kind": {
                  "const": "mock"
                },
                "provider": {
                  "const": "shirokuma-mock"
                },
                "model": {
                  "const": "shirokuma-deterministic-v1"
                },
                "endpoint": {
                  "type": "null"
                },
                "api_key_env": {
                  "type": "null"
                },
                "budget_usd": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "local": {
          "allOf": [
            {
              "$ref": "#/$defs/profile"
            },
            {
              "properties": {
                "kind": {
                  "const": "local-compatible"
                },
                "endpoint": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]|host\\.lima\\.internal)(:[0-9]{1,5})?/v1/?$"
                    }
                  ]
                },
                "api_key_env": {
                  "type": "null"
                },
                "budget_usd": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "cloud": {
          "allOf": [
            {
              "$ref": "#/$defs/profile"
            },
            {
              "properties": {
                "kind": {
                  "const": "cloud"
                },
                "enabled": {
                  "const": false
                },
                "endpoint": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^https://[^/@?#]+/v1/?$"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "enabled",
        "provider",
        "model",
        "endpoint",
        "api_key_env",
        "budget_usd",
        "timeout_seconds",
        "max_output_tokens"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mock",
            "local-compatible",
            "cloud"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "api_key_env": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "enable_thinking": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "active_provider": {
            "const": "mock"
          }
        }
      },
      "then": {
        "properties": {
          "providers": {
            "properties": {
              "mock": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_provider": {
            "const": "local"
          }
        }
      },
      "then": {
        "properties": {
          "providers": {
            "properties": {
              "local": {
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "provider": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "endpoint": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
